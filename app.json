{
  "expo": {
    "name": "Notepad-md",
    "slug": "Notepad-md",
    "scheme": "mdeditor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.golpgelop.notepadmd",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown File",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ],
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "txt"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIFileSharingEnabled": true,
        "UISupportsDocumentBrowser": true
      }
    },
    "android": {
      "navigationBar": {
        "backgroundColor": "#1a1a1a",
        "buttonStyle": "dark"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "content"
            },
            {
              "scheme": "file"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "mimeType": [
            "text/markdown",
            "text/plain",
            "text/x-markdown",
            "application/octet-stream"
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": {
            "scheme": "file",
            "host": "*",
            "pathPattern": ".*\\.md"
          }
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": {
            "scheme": "content",
            "host": "*",
            "pathPattern": ".*\\.md"
          }
        }
      ],
      "package": "com.golpgelop.notepadmd"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidNavigationBar": {
      "visible": "always",
      "backgroundColor": "#434343ff",
      "barStyle": "dark-content"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": true,
          "barStyle": "dark",
          "visibility": "visible"
        }
      ],
      "expo-router"
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": true,
        "barStyle": "dark",
        "visibility": "visible"
      },
      "router": {},
      "eas": {
        "projectId": "60165396-ba5b-4f25-8b54-5e67d0b49f2f"
      }
    }
  }
}
