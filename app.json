{
  "expo": {
    "name": "notepad-md",
    "slug": "notepad-md",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.golpgelop.notepadmd",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": ["com.golpgelop.notepadmd.markdown"],
            "CFBundleTypeRole": "Viewer"
          },
          {
            "CFBundleTypeName": "Text Document",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": ["public.plain-text"],
            "CFBundleTypeRole": "Viewer"
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.golpgelop.notepadmd.markdown",
            "UTTypeTagSpecification": {
              "public.filename-extension": ["md", "markdown", "mdown", "mkdn"],
              "public.mime-type": ["text/markdown", "text/x-markdown"]
            },
            "UTTypeConformsTo": ["public.text"],
            "UTTypeDescription": "Markdown Document"
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.golpgelop.notepadmd",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.md",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.markdown",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.txt",
              "mimeType": "text/plain"
            },
            {
              "scheme": "content",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "notepad-md"
  }
}